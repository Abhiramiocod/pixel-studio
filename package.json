{
  "name": "pixel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Studio monorepo: visual design editor (web), API (api) and shared design types.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter @pixel-studio/web dev",
    "dev:api": "pnpm --filter @pixel-studio/api start:dev",
    "build": "pnpm --recursive build",
    "build:web": "pnpm --filter @pixel-studio/web build",
    "build:api": "pnpm --filter @pixel-studio/api build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  }
}
